# Vite reads env files from this folder (`envDir: 'env'` in vite.config.ts).
# Copy to `env/.env.local` for personal overrides (git-ignored).
#
# Every VITE_* value is compiled into the client bundle and is visible to anyone
# who opens the app. NEVER put SMTP passwords, app tokens or API keys here.

VITE_APP_TITLE=Generic Payroll
VITE_APP_VERSION=1.0
VITE_APP_STAGE=PROD
VITE_ORG_NAME=Payroll Generator
VITE_ORG_UNIT=Admin & Financial Management

# OAuth Client ID (type "Web application") for the Gmail sign-in. This is a public identifier,
# not a secret, but leave it blank to keep the sign-in disabled. See the README for setup.
VITE_GOOGLE_CLIENT_ID=
